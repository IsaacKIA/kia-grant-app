# KIA Grant Management System 2.0 — Environment Variables Configuration

# Supabase Project Configuration
# Replace these with your Supabase project credentials from Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Application Settings
VITE_APP_TITLE="KIA Grant Management System 2.0"
VITE_APP_TIMEZONE="Africa/Accra"
VITE_DEFAULT_CURRENCY="GHS"

# Optional: Service Role Key for administrative and background scripts (NEVER expose to frontend)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

